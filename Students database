        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }

        th,
        td {
            border: 1px solid #d1d5db;
            padding: 10px;
            text-align: left;
        }

        th {
            background: #e5e7eb;
        }

        .code-box {
            position: relative;
            background: #111827;
            border-radius: 8px;
            margin: 15px 0;
            overflow: hidden;
        }

        pre {
            margin: 0;
            padding: 20px;
            padding-top: 45px;
            overflow-x: auto;
            color: #e5e7eb;
            font-family: Consolas, monospace;
            font-size: 13px;
            white-space: pre-wrap;
        }

        .copy-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            border: none;
            border-radius: 6px;
            padding: 7px 12px;
            background: #2563eb;
            color: white;
            cursor: pointer;
        }

        .copy-btn:hover {
            background: #1d4ed8;
        }

        .diagram {
            background: #f9fafb;
            border: 1px solid #d1d5db;
            padding: 20px;
            border-radius: 8px;
            font-family: monospace;
            white-space: pre-wrap;
        }

        .success {
            background: #ecfdf5;
            border-left: 5px solid #10b981;
            padding: 15px;
            margin-top: 15px;
        }

        .warning {
            background: #fffbeb;
            border-left: 5px solid #f59e0b;
            padding: 15px;
            margin-top: 15px;
        }

        .checklist {
            list-style: none;
            padding: 0;
        }

